LEDWALL_STATE_FILE=/var/lib/ledwall/state.json
LEDWALL_HOST=0.0.0.0
LEDWALL_PORT=5000

# Password for the API. Leave LEDWALL_PASSWORD empty or
# unset to disable auth entirely
LEDWALL_PASSWORD=a-longer-phrase-you-pick


LEDWALL_MQTT_ENABLED=1
LEDWALL_MQTT_HOST=127.0.0.1
LEDWALL_MQTT_PORT=1883
LEDWALL_MQTT_TOPIC_PREFIX=ledwall/screen
# LEDWALL_MQTT_USERNAME=
# LEDWALL_MQTT_PASSWORD=

# Live weather (Bright Sky, no API key). Defaults to CityLAB Berlin.
LEDWALL_WEATHER_ENABLED=1
# Defaults to weather.json next to LEDWALL_STATE_FILE.
# LEDWALL_WEATHER_FILE=/var/lib/ledwall/weather.json
# LEDWALL_WEATHER_LAT=52.4836
# LEDWALL_WEATHER_LON=13.3885
# LEDWALL_WEATHER_INTERVAL_S=600
