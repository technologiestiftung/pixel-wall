LEDWALL_STATE_FILE=/var/lib/ledwall/state.json
LEDWALL_HOST=0.0.0.0
LEDWALL_PORT=5000

# Password for the API. Leave LEDWALL_PASSWORD empty or
# unset to disable auth entirely
LEDWALL_PASSWORD=a-longer-phrase-you-pick


LEDWALL_MQTT_ENABLED=1
LEDWALL_MQTT_HOST=127.0.0.1
LEDWALL_MQTT_PORT=1883
LEDWALL_MQTT_TOPIC=ledwall/message
# LEDWALL_MQTT_USERNAME=
# LEDWALL_MQTT_PASSWORD=
