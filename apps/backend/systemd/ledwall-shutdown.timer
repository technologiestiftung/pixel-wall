[Unit]
Description=Pixel Wall daily soft shutdown schedule

[Timer]
# Templated by setup-pi.sh from LEDWALL_SHUTDOWN_AT (default 18:00). Runs
# independently of ledwall-backend, so the schedule holds even if the API
# has crashed — see CONTEXT.md "Power".
OnCalendar=*-*-* @SHUTDOWN_AT@:00
Persistent=false

[Install]
WantedBy=timers.target
