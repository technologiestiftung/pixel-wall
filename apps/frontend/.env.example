# The Pi on your LAN. Use its hostname or IP; the backend listens on 5000.
VITE_API_URL=http://raspberrypi.local:5000

# For local development against a backend on this machine, use 5001 instead:
# macOS binds port 5000 to the AirPlay Receiver, which answers requests without
# CORS headers and looks like a backend that is down.
# VITE_API_URL=http://127.0.0.1:5001

# Development only: run against the in-memory mock backend instead of a real
# one (src/api/mocks/). Unset or 0 means every request goes to VITE_API_URL.
# VITE_USE_MOCKS=1
