{
	"name": "pixel-wall",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"dev": "npm run dev --workspaces --if-present",
		"dev:frontend": "npm run dev --workspace @pixel-wall/frontend",
		"dev:backend": "npm run dev --workspace @pixel-wall/backend",
		"build": "npm run build --workspaces --if-present",
		"lint": "ESLINT_USE_FLAT_CONFIG=true eslint \"{apps,packages}/*/src/**/*\"",
		"prettier": "prettier --write --ignore-unknown \"{apps,packages}/*/{src,tests}/**/*\"",
		"prettier:ci": "prettier --check --ignore-unknown \"{apps,packages}/*/{src,tests}/**/*\"",
		"test:unit": "npm run test:unit --workspaces --if-present",
		"test:e2e": "npm run test:e2e --workspace @pixel-wall/frontend",
		"test:a11y": "npm run test:a11y --workspace @pixel-wall/frontend"
	},
	"devDependencies": {
		"@technologiestiftung/eslint-config": "0.3.1",
		"@technologiestiftung/prettier-config": "1.0.0",
		"@types/node": "22.7.4",
		"eslint": "9.11.1",
		"prettier": "3.3.3",
		"typescript": "5.5.4"
	}
}
