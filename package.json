{
	"name": "pixel-wall",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"workspaces": [
		"apps/frontend"
	],
	"scripts": {
		"dev": "npm run dev --workspace @pixel-wall/frontend",
		"dev:api": "cd apps/backend && LEDWALL_STATE_FILE=/tmp/ledwall-state.json LEDWALL_MQTT_ENABLED=0 .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 5001 --reload",
		"build": "npm run build --workspace @pixel-wall/frontend",
		"lint": "ESLINT_USE_FLAT_CONFIG=true eslint \"apps/frontend/src/**/*\"",
		"prettier": "prettier --write --ignore-unknown \"apps/frontend/{src,tests}/**/*\"",
		"prettier:ci": "prettier --check --ignore-unknown \"apps/frontend/{src,tests}/**/*\"",
		"test:unit": "npm run test:unit --workspace @pixel-wall/frontend",
		"test:backend": "cd apps/backend && .venv/bin/python -m pytest tests -q",
		"test:e2e": "npm run test:e2e --workspace @pixel-wall/frontend",
		"test:a11y": "npm run test:a11y --workspace @pixel-wall/frontend"
	},
	"devDependencies": {
		"@technologiestiftung/eslint-config": "0.3.1",
		"@technologiestiftung/prettier-config": "1.0.0",
		"@types/node": "22.7.4",
		"eslint": "9.11.1",
		"prettier": "3.3.3",
		"typescript": "5.5.4"
	}
}
